{
  // Landing page, anonymous usage collection, and the admin view.
  // Deploy with: npx wrangler deploy
  "name": "adobe-mcp",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "assets": { "directory": "./site", "binding": "ASSETS" },

  // Write-heavy, read-rare, and free at this scale. It also cannot become a
  // place a document name ends up by accident.
  "analytics_engine_datasets": [
    { "binding": "USAGE", "dataset": "moskito_easy_mcp_usage" }
  ]

  // /admin needs Cloudflare Access in front of it, restricted to the
  // moskitodesign.it domain, plus two secrets for the SQL API:
  //   npx wrangler secret put CF_ACCOUNT_ID
  //   npx wrangler secret put CF_API_TOKEN
}
