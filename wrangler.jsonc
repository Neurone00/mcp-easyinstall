{
  // Landing page, anonymous usage collection, and the update push signal.
  // The admin view is its own Worker: wrangler.admin.jsonc.
  // Deploy with: npx wrangler deploy
  "name": "adobe-mcp",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "assets": { "directory": "./site", "binding": "ASSETS" },

  // Write-heavy, read-rare, and free at this scale. It also cannot become a
  // place a document name ends up by accident.
  "analytics_engine_datasets": [
    { "binding": "USAGE", "dataset": "moskito_easy_mcp_usage" }
  ],

  // One key, "push": when it changes, every running app skips its six-hour
  // update cache and checks GitHub at once. The admin page writes it; the
  // public Worker serves it at /signal.
  // Usage rows, read by the admin Worker. Schema: usage-schema.sql.
  "d1_databases": [
    { "binding": "DB", "database_name": "moskito-usage", "database_id": "06893cd4-c4a0-4ea0-8b9e-d19085528f9f" }
  ],

  "kv_namespaces": [
    { "binding": "SIGNAL", "id": "24f1e1684eff4ec4a2e871d800fd1951" }
  ]
}
